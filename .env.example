# Runtime mode
APP_ENV=development
SIMULATION_MODE=true
ENABLE_REAL_ACTIONS=false

# API
API_HOST=127.0.0.1
API_PORT=8000

# Datastores (used in later phases)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecom_resolution
REDIS_URL=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO
